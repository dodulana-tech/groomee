generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  PRO
}

enum ProStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("GroomerStatus")
}

enum ProAvail {
  ONLINE
  BUSY
  OFFLINE

  @@map("GroomerAvail")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum BookingStatus {
  PENDING_PAYMENT
  DISPATCHING
  NO_GROOMER
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_SERVICE
  COMPLETED
  CONFIRMED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  AUTHORISED
  CAPTURED
  REFUNDED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum ProRelationship {
  INDEPENDENT
  APPRENTICE
  STAFF
}

enum ApprenticeshipStatus {
  PENDING_ACCEPT
  IN_TRAINING
  READY_FOR_FREEDOM
  FREED
  TERMINATED
}

enum EarningType {
  SERVICE
  APPRENTICE_COMMISSION
  TIP
  ADJUSTMENT
}

enum ServiceCategory {
  HAIR
  MAKEUP
  NAILS
  BARBING
  LASHES
  SKINCARE
  OTHER
}

enum HealthCategory {
  SKIN_SENSITIVITY
  ALLERGY
  MOBILITY
  REPRODUCTIVE
  CHRONIC
  MEDICATION
  OTHER
}

enum HealthSeverity {
  MILD
  MODERATE
  SEVERE
}

enum ContraindicationLevel {
  INFO
  WARN
  BLOCK
}

enum HealthVisibility {
  ALWAYS_SHARE
  ASK_PER_BOOKING
  PRIVATE
}

// ─── WALLET ──────────────────────────────────────────────────────────────────
// Every ± movement against a pro's running balance carries a type so we can
// trace it back to the lifecycle event that produced it.

enum WalletMovementType {
  MOBILIZATION // +X% of proEarning posted at ACCEPTED so pro can fund transport/supplies
  COMPLETION_RELEASE // +Y% posted at COMPLETED
  CONFIRM_RELEASE // +Z% posted at CONFIRMED (the last slice of the proEarning)
  APPRENTICE_COMMISSION_RELEASE // +master's cut on a dependent's confirmed booking
  CLAWBACK // -reversal of any of the above on refund/cancel
  ADVANCE_DISBURSED // +cash to pro when admin approves an advance
  ADVANCE_REPAYMENT // -as the pro repays out of future earnings
  PAYOUT_DEBIT // -when a payout transfer is initiated
  PAYOUT_REVERSAL // +when a Paystack transfer fails and is returned
  MANUAL_ADJUSTMENT // +/- admin one-off correction (audit-logged)
  SAVINGS_SKIM // -funds moved from payout into the pro's savings vault
  BENEFIT_PREMIUM // -placeholder for Concept #9 (future slice)
}

// ─── SAVINGS ─────────────────────────────────────────────────────────────────
// Bank Build: pros opt in (default on) to skimming a configurable percent of
// every payout into a vault. They can withdraw with a notice period, or take
// an instant withdrawal subject to a configurable penalty. Built today on top
// of the live Earning/Payout flow; the WalletLedger gets a parallel
// SAVINGS_SKIM row so it stays the canonical audit trail once the wallet
// becomes source-of-truth.

enum SavingsMovementType {
  SKIM                 // +cash deducted from a payout and credited here
  WITHDRAWAL_REQUEST   // -amount reserved against balance, awaits notice/release
  WITHDRAWAL_RELEASED  // 0 sentinel: PENDING → PAID transition (balance already reserved)
  WITHDRAWAL_CANCELLED // +reverse a pending request (refund the reservation)
  MATCH_BONUS          // +platform retention match
  INTEREST_CREDIT      // +partner fintech yield (placeholder)
  ADJUSTMENT           // +/- admin one-off correction (audit-logged)
  CLAWBACK             // -reversal of an in-window SKIM when a booking is refunded/cancelled
  EARLY_BREAK_PENALTY  // -platform-retained haircut on instant-break withdrawals
}

enum SavingsWithdrawalStatus {
  PENDING   // notice period ticking
  ELIGIBLE  // notice elapsed; awaiting worker release
  PAID
  CANCELLED
  FAILED    // Paystack transfer failed; admin must retry/refund
}

model User {
  id                String         @id @default(cuid())
  phone             String?        @unique
  name              String?
  email             String?        @unique
  role              UserRole       @default(CUSTOMER)
  points            Int            @default(0)
  adminRoleId       String?
  adminRole         AdminRole?     @relation(fields: [adminRoleId], references: [id])
  lastActiveAt      DateTime?
  sessionsValidFrom DateTime?
  bookings          Booking[]
  favouritePros     FavouritePro[]
  beautyProfile     BeautyProfile?
  subscriptions     Subscription[]
  giftCardsSent     GiftCard[]     @relation("GiftSender")
  giftCardsUsed     GiftCard[]     @relation("GiftRedeemer")
  referralsMade     Referral[]     @relation("Referrer")
  referralsReceived Referral[]     @relation("Referred")
  notes             Note[]
  activityLogs      ActivityLog[]
  pointsLedger      PointsLedger[]
  pro               Pro?
  healthProfile     HealthProfile?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("users")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_roles")
}

model Note {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("notes")
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@map("activity_logs")
}

model Pro {
  id               String           @id @default(cuid())
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id])
  name             String
  phone            String           @unique
  status           ProStatus        @default(PENDING)
  availability     ProAvail         @default(OFFLINE)
  currentBookingId String?
  commission       Float            @default(0.20)
  avgRating        Float            @default(0)
  reviewCount      Int              @default(0)
  totalJobs        Int              @default(0)
  acceptanceRate   Float            @default(0)
  strikeCount      Int              @default(0) @map("strikes")
  bankCode         String?
  bankAccount      String?
  bankName         String?
  bankAccountNo    String?
  idVerified       Boolean          @default(false)
  gender           Gender?
  photo            String?
  bio              String?
  services         ProService[]
  zones            ProZone[]
  bookings         Booking[]
  earnings         Earning[]
  favouritedBy     FavouritePro[]
  advances         ProAdvance[]
  creditEvents     ProCreditEvent[]
  strikes          Strike[]
  payouts          Payout[]
  schedule         ProSchedule[]

  // ─── Apprenticeship / sub-account ───
  relationship                ProRelationship        @default(INDEPENDENT)
  parentProId                 String?
  parent                      Pro?                   @relation("ParentPro", fields: [parentProId], references: [id])
  dependents                  Pro[]                  @relation("ParentPro")
  freedUnderProId             String?
  freedUnder                  Pro?                   @relation("FreedomLineage", fields: [freedUnderProId], references: [id])
  freedDependents             Pro[]                  @relation("FreedomLineage")
  freedAt                     DateTime?
  freedomCertCode             String?                @unique
  apprenticeshipsAsApprentice Apprenticeship[]       @relation("ApprenticeshipApprentice")
  apprenticeshipsAsMaster     Apprenticeship[]       @relation("ApprenticeshipMaster")
  earningsFromDependents      Earning[]              @relation("SourcePro")
  healthAcks                  HealthAcknowledgment[]
  wallet                      ProWallet?
  walletMovements             WalletLedger[]
  savingsAccount              ProSavingsAccount?
  savingsMovements            SavingsMovement[]
  savingsWithdrawals          SavingsWithdrawal[]
  inventories                 ProInventory[]
  inventoryTxns               InventoryTxn[]
  benefitEnrollments          ProBenefitEnrollment[]
  benefitDebits               BenefitDebit[]
  benefitClaims               BenefitClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentProId])
  @@index([freedUnderProId])
  @@map("groomers")
}

model Apprenticeship {
  id                         String               @id @default(cuid())
  apprenticeId               String
  apprentice                 Pro                  @relation("ApprenticeshipApprentice", fields: [apprenticeId], references: [id])
  masterId                   String
  master                     Pro                  @relation("ApprenticeshipMaster", fields: [masterId], references: [id])
  status                     ApprenticeshipStatus @default(PENDING_ACCEPT)
  // Master's cut of (totalAmount − platform commission) on every dependent activity. Default 30%, configurable.
  masterCommission           Float                @default(0.30)
  // Master must explicitly approve independence; combined with curriculum gates this unlocks self-bookings.
  masterApprovedIndependence DateTime?
  invitedAt                  DateTime             @default(now())
  acceptedAt                 DateTime?
  expectedFreedom            DateTime?
  readyForFreedomAt          DateTime?
  freedomDate                DateTime?
  freedomCertCode            String?              @unique
  terminatedAt               DateTime?
  terminationReason          String?
  modules                    CurriculumModule[]
  earnings                   Earning[]

  @@index([apprenticeId])
  @@index([masterId])
  @@index([status])
  @@map("apprenticeships")
}

model CurriculumModule {
  id                String         @id @default(cuid())
  apprenticeshipId  String
  apprenticeship    Apprenticeship @relation(fields: [apprenticeshipId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  sortOrder         Int            @default(0)
  required          Boolean        @default(true)
  // When true, completion of this module is required for the apprentice to take independent bookings.
  gatesIndependence Boolean        @default(false)
  completedAt       DateTime?
  masterSignoffAt   DateTime?
  notes             String?

  @@index([apprenticeshipId])
  @@map("curriculum_modules")
}

model FavouritePro {
  id        String   @id @default(cuid())
  userId    String
  proId     String   @map("groomerId")
  priority  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, proId])
  @@map("favourite_pros")
}

model Service {
  id                String                    @id @default(cuid())
  name              String
  slug              String                    @unique
  category          ServiceCategory
  basePrice         Float
  minPrice          Float
  maxPrice          Float
  durationMins      Int
  description       String?
  isActive          Boolean                   @default(true)
  sortOrder         Int                       @default(0)
  pros              ProService[]
  bookings          Booking[]
  bookingItems      BookingItem[]
  contraindications ServiceContraindication[]
  recipes           ServiceRecipe[]
  createdAt         DateTime                  @default(now())

  @@map("services")
}

// Operational state of a city. Drives the landing-page surfaces and gates
// new bookings — non-LIVE cities cannot accept bookings or display pros to
// customers, even if zones exist for them.
enum CityStatus {
  HIDDEN
  WAITLIST
  LIVE
}

model City {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  status     CityStatus @default(WAITLIST)
  launchedAt DateTime?
  // Display copy on the landing waitlist banner. Optional — falls back to
  // the city name.
  tagline    String?
  // Stable ordering for nav / banner. Lower = earlier.
  sortOrder  Int        @default(0)
  zones      Zone[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("cities")
}

model Zone {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  // Legacy display-only "Lagos" / "Abuja" string. Kept until every reader
  // is migrated to read via cityId. New code MUST use city/cityId.
  city       String       @default("Lagos")
  cityId     String?
  cityRel    City?        @relation(fields: [cityId], references: [id])
  pros       ProZone[]
  bookings   Booking[]
  travelFrom ZoneTravel[] @relation("ZoneTravelFrom")
  travelTo   ZoneTravel[] @relation("ZoneTravelTo")

  @@map("zones")
}

model ProService {
  proId       String  @map("groomerId")
  serviceId   String
  customPrice Float?
  pro         Pro     @relation(fields: [proId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([proId, serviceId])
  @@map("groomer_services")
}

model ProZone {
  proId  String @map("groomerId")
  zoneId String
  pro    Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([proId, zoneId])
  @@map("groomer_zones")
}

model Booking {
  id                        String                @id @default(cuid())
  reference                 String                @unique
  customerId                String
  proId                     String?               @map("groomerId")
  serviceId                 String
  zoneId                    String?
  status                    BookingStatus         @default(PENDING_PAYMENT)
  address                   String
  latitude                  Float?
  longitude                 Float?
  isAsap                    Boolean               @default(false)
  scheduledFor              DateTime?
  // Cached total duration in minutes (sum of service durations). Computed at
  // booking creation; falls back to service.durationMins when zero/legacy.
  // Drives calendar block sizes and conflict detection.
  durationMins              Int                   @default(0)
  customerNotes             String?
  totalAmount               Float
  baseAmount                Float
  surchargeAmount           Float                 @default(0)
  surchargeType             String?
  proEarning                Float                 @default(0) @map("groomerEarning")
  dispatchAttempts          Int                   @default(0)
  acceptedAt                DateTime?
  enRouteAt                 DateTime?
  arrivedAt                 DateTime?
  completedAt               DateTime?
  confirmedAt               DateTime?
  cancelledAt               DateTime?
  // When a master delegates a booking to an apprentice (or staff), we
  // snapshot the apprenticeship id so the earnings split at confirm time
  // is durable even if the apprenticeship later transitions to FREED or
  // TERMINATED. Null for non-delegated bookings.
  delegatedApprenticeshipId String?
  customer                  User                  @relation(fields: [customerId], references: [id])
  pro                       Pro?                  @relation(fields: [proId], references: [id])
  service                   Service               @relation(fields: [serviceId], references: [id])
  zone                      Zone?                 @relation(fields: [zoneId], references: [id])
  payment                   Payment?
  dispute                   Dispute?
  review                    Review?
  dispatchLog               DispatchLog[]
  strikes                   Strike[]
  items                     BookingItem[]
  healthAck                 HealthAcknowledgment?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([customerId, createdAt])
  @@index([proId])
  @@index([status, createdAt])
  @@map("bookings")
}

// Additional services attached to a Booking. The primary service stays on
// Booking.serviceId for backward compatibility; this table holds any extras
// the customer chained (e.g. "loosen + wash + reloc"). Total booking duration
// = Booking.durationMins, which is computed as primary.durationMins +
// sum(items.durationMins) at create time.
model BookingItem {
  id           String   @id @default(cuid())
  bookingId    String
  serviceId    String
  customPrice  Float?
  durationMins Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@map("booking_items")
}

model DispatchLog {
  id        String    @id @default(cuid())
  bookingId String
  proId     String    @map("groomerId")
  proName   String    @map("groomerName")
  offeredAt DateTime  @default(now())
  response  String?
  respondAt DateTime?
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([proId])
  @@map("dispatch_logs")
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  reference    String        @unique
  amount       Float
  status       PaymentStatus @default(PENDING)
  paystackRef  String?
  authorisedAt DateTime?
  capturedAt   DateTime?
  refundedAt   DateTime?
  refundAmount Float?
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@index([status, capturedAt])
  @@map("payments")
}

model Dispute {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  status       DisputeStatus @default(OPEN)
  reason       String
  notes        String?
  resolution   String?
  refundAmount Float?
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@map("disputes")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  rating    Int
  text      String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Earning {
  proId     String   @map("groomerId")
  id        String   @id @default(cuid())
  bookingId String
  amount    Float
  paid      Boolean  @default(false)
  payoutId  String?
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // ─── Apprenticeship support ───
  // SERVICE: pro's own work earning (default).
  // APPRENTICE_COMMISSION: master's cut from a dependent's booking.
  type             EarningType     @default(SERVICE)
  // For APPRENTICE_COMMISSION rows, the dependent who actually performed the work.
  sourceProId      String?
  sourcePro        Pro?            @relation("SourcePro", fields: [sourceProId], references: [id])
  // Tags master-commission earnings to the apprenticeship that produced them; useful for audit / freedom-cutoff queries.
  apprenticeshipId String?
  apprenticeship   Apprenticeship? @relation(fields: [apprenticeshipId], references: [id])

  @@unique([bookingId, proId, type])
  @@index([proId, paid])
  @@index([sourceProId])
  @@index([apprenticeshipId])
  @@map("earnings")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model Notification {
  id        String    @id @default(cuid())
  recipient String
  channel   String
  message   String
  status    String
  sentAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([phone])
}

model SurveyResponse {
  id        String   @id @default(cuid())
  type      String
  phone     String?
  email     String?
  answers   Json
  createdAt DateTime @default(now())

  @@map("survey_responses")
}

// One row per tap on a tracked "chat on WhatsApp" CTA (/api/wa). Lets the
// weekly admin report attribute WhatsApp-concierge demand by city + surface.
model WhatsAppClick {
  id        String   @id @default(cuid())
  city      String?
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("whatsapp_clicks")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  name      String?
  city      String   @default("Abuja")
  area      String?
  role      String   @default("customer")
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model BeautyProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  hairType          String?
  hairLength        String?
  hairTexture       String?
  scalpCondition    String?
  colourTreated     Boolean  @default(false)
  skinTone          String?
  skinType          String?
  allergies         String[] @default([])
  preferredProducts String[] @default([])
  avoidProducts     String[] @default([])
  favouriteStyles   String[] @default([])
  styleNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("beauty_profiles")
}

model SubscriptionPlan {
  id               String         @id @default(cuid())
  name             String
  price            Float
  credits          Int
  discountRate     Float          @default(0)
  priorityDispatch Boolean        @default(false)
  description      String?
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())

  @@map("subscription_plans")
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  planId             String
  status             String              @default("PENDING")
  currentPeriodStart DateTime            @default(now())
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  creditsRemaining   Int
  creditsTotal       Int
  cancelledAt        DateTime?
  cancelReason       String?
  paystackAuthCode   String?
  user               User                @relation(fields: [userId], references: [id])
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id])
  usages             SubscriptionUsage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             String       @id @default(cuid())
  subscriptionId String
  bookingId      String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime     @default(now())

  @@map("subscription_usages")
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  senderId       String
  recipientPhone String
  recipientName  String?
  message        String?
  serviceId      String?
  amount         Float
  expiresAt      DateTime
  isRedeemed     Boolean   @default(false)
  redeemedAt     DateTime?
  redeemedBy     String?
  bookingId      String?
  sender         User      @relation("GiftSender", fields: [senderId], references: [id])
  redeemer       User?     @relation("GiftRedeemer", fields: [redeemedBy], references: [id])
  createdAt      DateTime  @default(now())

  @@map("gift_cards")
}

model ProAdvance {
  id        String   @id @default(cuid())
  proId     String   @map("groomerId")
  amount    Float
  reason    String
  status    String   @default("PENDING")
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("pro_advances")
}

model ProCreditEvent {
  id          String   @id @default(cuid())
  proId       String   @map("groomerId")
  eventType   String
  points      Int
  description String
  pro         Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("pro_credit_events")
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredPhone  String   @default("")
  referredUserId String?
  bonusAmount    Float    @default(2000)
  bonusPaid      Boolean  @default(false)
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  referred       User?    @relation("Referred", fields: [referredUserId], references: [id])
  createdAt      DateTime @default(now())

  @@map("referrals")
}

model Strike {
  id        String   @id @default(cuid())
  proId     String   @map("groomerId")
  bookingId String
  reason    String
  notes     String?
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("strikes")
}

model PointsLedger {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  referenceId String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("points_ledger")
}

model Payout {
  id                 String    @id @default(cuid())
  proId              String    @map("groomerId")
  amount             Float
  status             String    @default("PROCESSING")
  paystackTransferId String?
  recipientCode      String?
  periodStart        DateTime
  periodEnd          DateTime
  processedAt        DateTime?
  failureReason      String?
  pro                Pro       @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())

  @@map("payouts")
}

// Admin-tuned travel time matrix between zones. Used by the scheduler to add
// transit buffers between consecutive bookings for the same pro. Missing pairs
// fall back to scheduling.DEFAULT_CROSS_ZONE_MINS; same-zone pairs are 0.
model ZoneTravel {
  id         String   @id @default(cuid())
  fromZoneId String
  toZoneId   String
  travelMins Int
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  fromZone   Zone     @relation("ZoneTravelFrom", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZone     Zone     @relation("ZoneTravelTo", fields: [toZoneId], references: [id], onDelete: Cascade)

  @@unique([fromZoneId, toZoneId])
  @@index([fromZoneId])
  @@map("zone_travel")
}

model ProSchedule {
  id        String  @id @default(cuid())
  proId     String  @map("groomerId")
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@unique([proId, dayOfWeek])
  @@map("pro_schedules")
}

// ─── HEALTH PROFILES ─────────────────────────────────────────────────────────
//
// Customers may share health information (allergies, sensitivities, mobility
// conditions, pregnancy status, chronic conditions) that affects how a pro
// should perform a service. Sensitive — treat as health-adjacent PHI. Every
// pro/admin read is access-logged.

model HealthProfile {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes           String? // free-text "anything else we should know?"
  visibility      HealthVisibility       @default(ALWAYS_SHARE)
  conditions      HealthCondition[]
  acknowledgments HealthAcknowledgment[]
  accessLogs      HealthAccessLog[]
  lastReviewedAt  DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("health_profiles")
}

model HealthCondition {
  id        String         @id @default(cuid())
  profileId String
  profile   HealthProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Controlled vocab — see HEALTH_CONDITIONS in src/lib/health.ts. Free text
  // sits in `notes` on the profile itself.
  code      String
  // Snapshot of the user-facing label at creation time (in case vocab changes).
  label     String
  category  HealthCategory
  severity  HealthSeverity @default(MODERATE)
  notes     String?
  startedAt DateTime?
  resolved  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([profileId])
  @@index([code])
  @@map("health_conditions")
}

model ServiceContraindication {
  id            String                @id @default(cuid())
  conditionCode String
  // Null serviceId = applies to ANY service offering. Useful for general
  // allergies (latex) where the warning is uniform across categories.
  serviceId     String?
  service       Service?              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  level         ContraindicationLevel
  message       String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([conditionCode, serviceId])
  @@index([conditionCode])
  @@map("service_contraindications")
}

model HealthAcknowledgment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  profileId      String
  profile        HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  proId          String
  pro            Pro           @relation(fields: [proId], references: [id])
  // Frozen view of the profile + conditions at acknowledgement time, so
  // changes to the profile later don't rewrite history.
  snapshot       Json
  acknowledgedAt DateTime      @default(now())

  @@index([proId])
  @@map("health_acknowledgments")
}

model HealthAccessLog {
  id           String        @id @default(cuid())
  profileId    String
  profile      HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accessorRole String
  accessorId   String?
  context      String
  createdAt    DateTime      @default(now())

  @@index([profileId, createdAt])
  @@map("health_access_logs")
}

// ─── WALLET ──────────────────────────────────────────────────────────────────
//
// One ProWallet row per pro (lazy-init on first movement). Stores derived
// running totals so we don't aggregate the whole ledger on every read.
// Source of truth is WalletLedger - if you ever doubt the cached values,
// SUM(amount) over the ledger gives you the canonical balance.

model ProWallet {
  id             String   @id @default(cuid())
  proId          String   @unique @map("groomerId")
  pro            Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  // Cash-available the pro can be paid out.
  available      Float    @default(0)
  // Held for in-flight bookings (mobilization that has been released but the
  // booking has not yet CONFIRMED - if cancelled, will be clawed back).
  pending        Float    @default(0)
  // Maximum negative balance the pro can carry (mobilization clawbacks may
  // briefly push them into the red; this caps the risk).
  creditLimit    Float    @default(0)
  // Cumulative running figure of cash advanced to the pro that has not yet
  // been recovered out of future earnings. Decreases with each repayment
  // movement. Read-only mirror of ledger math.
  netAdvanceOwed Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("pro_wallets")
}

model WalletLedger {
  id               String             @id @default(cuid())
  proId            String             @map("groomerId")
  pro              Pro                @relation(fields: [proId], references: [id], onDelete: Cascade)
  type             WalletMovementType
  amount           Float // signed; +credit, -debit
  // Running balance AFTER this movement is applied. Lets us audit/forensic
  // without re-summing the whole ledger.
  balanceAfter     Float
  // Optional linkages back to the lifecycle event that produced this row.
  bookingId        String?
  advanceId        String?
  payoutId         String?
  sourceProId      String?
  apprenticeshipId String?
  // Free-form note shown to the pro in their wallet history.
  note             String?
  // Idempotency key. Compound unique with proId lets us de-dupe re-tries of
  // the same lifecycle event (e.g. concurrent confirms trying to post
  // CONFIRM_RELEASE).
  idempotencyKey   String?
  createdAt        DateTime           @default(now())

  @@unique([proId, idempotencyKey])
  @@index([proId, createdAt])
  @@index([bookingId])
  @@index([advanceId])
  @@index([payoutId])
  @@map("wallet_ledger")
}

// ─── FORCED SAVINGS / EARNINGS RESERVE (Concept #5) ──────────────────────────
// One vault per pro. Each CONFIRMED booking triggers a SKIM movement
// (configurable %) into the vault. Withdrawals are gated by a notice period
// (default 14d) OR an instant break with a configurable penalty (default 20%
// of withdrawal amount, retained as MATCH_BONUS forfeit). Buckets are tracked
// per-skim so partial clawback on disputed bookings is forensic.
//
// SavingsLedger is the source of truth; ProSavingsAccount.balance* are cached.

model ProSavingsAccount {
  id                  String              @id @default(cuid())
  proId               String              @unique @map("groomerId")
  pro                 Pro                 @relation(fields: [proId], references: [id], onDelete: Cascade)
  optedIn             Boolean             @default(false)
  optedInAt           DateTime?
  optedOutAt          DateTime?
  skimRate            Float               @default(0.05) // 0.02 - 0.15
  goalLabels          String[]            @default([]) // user-defined labels (Rent / School / Tools)
  // Cached running totals. Source of truth is SavingsMovement aggregation.
  balanceAvailable    Float               @default(0) // matured + non-reserved
  balanceLocked       Float               @default(0) // within notice period
  balancePendingWd    Float               @default(0) // reserved by open withdrawals
  totalSkimmed        Float               @default(0) // lifetime gross in
  totalMatchEarned    Float               @default(0) // lifetime bonus credited
  totalWithdrawn      Float               @default(0) // lifetime out
  totalClawedBack     Float               @default(0) // lifetime reversed
  noticeDays          Int                 @default(14)
  penaltyPct          Float               @default(0.20)
  movements           SavingsMovement[]
  withdrawals         SavingsWithdrawal[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("pro_savings_accounts")
}

model SavingsMovement {
  id              String               @id @default(cuid())
  accountId       String
  account         ProSavingsAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proId           String               @map("groomerId")
  pro             Pro                  @relation(fields: [proId], references: [id], onDelete: Cascade)
  type            SavingsMovementType
  amount          Float                // signed; +credit, -debit
  balanceAfter    Float                // available balance after this row
  bookingId       String?              // for SKIM / CLAWBACK
  withdrawalId    String?              // for WITHDRAWAL_REQUEST / RELEASED / CANCELLED
  walletLedgerId  String?              // pairs the SKIM with the wallet's SAVINGS_SKIM debit
  goalLabel       String?              // if pro tagged the skim/withdrawal
  note            String?
  idempotencyKey  String?              // dedup retries (booking:{id}:SAVINGS_SKIM:{proId})
  createdAt       DateTime             @default(now())

  @@unique([proId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([proId, createdAt])
  @@index([bookingId])
  @@index([withdrawalId])
  @@map("savings_movements")
}

model SavingsWithdrawal {
  id              String                  @id @default(cuid())
  accountId       String
  account         ProSavingsAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proId           String                  @map("groomerId")
  pro             Pro                     @relation(fields: [proId], references: [id], onDelete: Cascade)
  amount          Float                   // gross requested
  penaltyAmount   Float                   @default(0) // forfeited if instant-break
  netAmount       Float                   // amount actually paid out
  status          SavingsWithdrawalStatus @default(PENDING)
  isInstant       Boolean                 @default(false) // true if pro chose break-with-penalty
  noticeUntil     DateTime?               // PENDING → ELIGIBLE at this time
  releasedAt      DateTime?               // moved to PAID
  cancelledAt     DateTime?
  failureReason   String?
  payoutId        String?                 // links into Payout flow when released
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([proId, status])
  @@index([status, noticeUntil])
  @@map("savings_withdrawals")
}

// ─── INVENTORY (Concept #2) ──────────────────────────────────────────────────
// Product catalog (admin-managed) + per-pro stock + service recipes that
// auto-decrement on CONFIRMED. Recipes are admin-defined per service (e.g.
// "Knotless Braids consumes 1 bottle of leave-in conditioner"). Decrement
// runs in the same tx as the confirm wallet movement so the audit trail
// is consistent.

enum ProductCategory {
  HAIR_CARE
  MAKEUP
  NAILS
  LASHES
  SKINCARE
  TOOLS
  CONSUMABLE
  OTHER
}

enum InventoryTxnReason {
  INITIAL_STOCK
  RESTOCK
  BOOKING_DECREMENT
  ADMIN_ADJUSTMENT
  WASTE
  CORRECTION
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  sku         String?         @unique
  category    ProductCategory
  unit        String          @default("piece") // ml / g / piece / bottle
  unitCost    Float           @default(0)       // ₦ per unit (admin's reference cost)
  description String?
  photo       String?
  isActive    Boolean         @default(true)
  recipes     ServiceRecipe[]
  inventories ProInventory[]
  txns        InventoryTxn[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("products")
}

model ServiceRecipe {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyPerService Float    @default(1)
  isOptional    Boolean  @default(false) // optional recipes don't trigger low-stock alerts on zero
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([serviceId, productId])
  @@index([productId])
  @@map("service_recipes")
}

model ProInventory {
  id                String         @id @default(cuid())
  proId             String         @map("groomerId")
  pro               Pro            @relation(fields: [proId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOnHand         Float          @default(0)
  lowStockThreshold Float          @default(3)
  lastRestockedAt   DateTime?
  lastAlertSentAt   DateTime?
  txns              InventoryTxn[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([proId, productId])
  @@index([proId])
  @@map("pro_inventories")
}

model InventoryTxn {
  id          String             @id @default(cuid())
  proId       String             @map("groomerId")
  pro         Pro                @relation(fields: [proId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryId String?
  inventory   ProInventory?      @relation(fields: [inventoryId], references: [id])
  delta       Float              // signed; +restock, -consumption
  qtyAfter    Float              // qtyOnHand after this row
  reason      InventoryTxnReason
  bookingId   String?            // for BOOKING_DECREMENT
  note        String?
  createdAt   DateTime           @default(now())

  @@index([proId, createdAt])
  @@index([productId, createdAt])
  @@index([bookingId])
  @@map("inventory_txns")
}

// ─── BENEFITS / INSURANCE (Concept #9) ───────────────────────────────────────
// Pros enrol in benefit plans (HMO + accident bundle). A monthly cron debits
// the premium from the wallet (BENEFIT_PREMIUM movement). Subsidy by tier:
// Standard 0%, Pro 50%, Elite 100%. Insufficient balance → GRACE for 14d,
// then PAUSED for 30d, then CANCELLED. Reactivation requires fresh waiting.
// Groomee never holds PHI: claims are handoff records only.

enum BenefitKind {
  HMO
  ACCIDENT
  BUNDLE
}

enum BenefitEnrollmentStatus {
  PENDING       // awaiting first debit
  ACTIVE
  GRACE         // recent debit failed; cover still active until graceUntil
  PAUSED        // grace elapsed; cover paused; can reactivate
  CANCELLED     // fully off; re-enrol needs fresh waiting period
}

enum BenefitDebitStatus {
  SUCCESS
  INSUFFICIENT_FUNDS
  SKIPPED       // enrolment paused/cancelled during the run
  FAILED        // unexpected error
}

enum BenefitClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model BenefitPlan {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  kind            BenefitKind
  provider        String                 // "Reliance HMO + Leadway"
  monthlyPremium  Float                  // gross, before subsidy
  coverAmount     Float?                 // sum assured / cover limit
  description     String?
  highlights      String[]               @default([]) // bulleted benefit list
  // Eligibility gates (override Setting defaults).
  minBookings     Int                    @default(5)
  minTenureDays   Int                    @default(30)
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  subsidyRules    BenefitSubsidyRule[]
  enrollments     ProBenefitEnrollment[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("benefit_plans")
}

model BenefitSubsidyRule {
  id         String      @id @default(cuid())
  planId     String
  plan       BenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  proTier    String      // "STANDARD" | "PRO" | "ELITE"
  subsidyPct Float       @default(0) // 0.0 - 1.0
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([planId, proTier])
  @@map("benefit_subsidy_rules")
}

model ProBenefitEnrollment {
  id               String                  @id @default(cuid())
  proId            String                  @map("groomerId")
  pro              Pro                     @relation(fields: [proId], references: [id], onDelete: Cascade)
  planId           String
  plan             BenefitPlan             @relation(fields: [planId], references: [id])
  status           BenefitEnrollmentStatus @default(PENDING)
  enrolledAt       DateTime                @default(now())
  activatedAt      DateTime?               // first successful debit
  nextDebitAt      DateTime
  lastDebitAt      DateTime?
  graceUntil       DateTime?
  pausedAt         DateTime?
  cancelledAt      DateTime?
  externalPolicyNo String?                 // HMO / insurer's policy number
  enrolledByAdmin  String?                 // admin user id who manually enrolled (if any)
  notes            String?
  debits           BenefitDebit[]
  claims           BenefitClaim[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([proId, planId])
  @@index([status, nextDebitAt])
  @@map("pro_benefit_enrollments")
}

model BenefitDebit {
  id             String               @id @default(cuid())
  enrollmentId   String
  enrollment     ProBenefitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  proId          String               @map("groomerId")
  pro            Pro                  @relation(fields: [proId], references: [id], onDelete: Cascade)
  period         String               // YYYY-MM
  premiumGross   Float                // full premium before subsidy
  subsidyAmount  Float                @default(0)
  amountDebited  Float                // premiumGross - subsidyAmount
  status         BenefitDebitStatus
  walletLedgerId String?              // points at the BENEFIT_PREMIUM ledger row
  failureReason  String?
  createdAt      DateTime             @default(now())

  @@unique([enrollmentId, period])
  @@index([proId, createdAt])
  @@map("benefit_debits")
}

model BenefitClaim {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   ProBenefitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  proId        String               @map("groomerId")
  pro          Pro                  @relation(fields: [proId], references: [id], onDelete: Cascade)
  kind         BenefitKind
  status       BenefitClaimStatus   @default(OPEN)
  summary      String               // no PHI - just a handoff label ("hospital visit", "accident")
  externalRef  String?              // claim # at the HMO/insurer
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([proId, createdAt])
  @@map("benefit_claims")
}
